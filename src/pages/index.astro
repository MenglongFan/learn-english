---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const lessons = (await getCollection('lessons')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const latest = lessons[0];
const rest = lessons.slice(1);

// 按月归档，月内标注场景域
const byMonth = new Map<string, typeof lessons>();
for (const l of lessons) {
  const m = l.data.date.slice(0, 7);
  if (!byMonth.has(m)) byMonth.set(m, []);
  byMonth.get(m)!.push(l);
}
---
<BaseLayout title={latest ? latest.data.title : '今日'}>
  {latest && (
    <section class="card hero">
      <p class="muted date-label">{latest.data.date} · 今日一课</p>
      <h1>{latest.data.title}</h1>
      <p>
        <span class="tag">{latest.data.domain}</span>
        <span class="tag">{latest.data.subScenario}</span>
        {latest.data.material.duration && <span class="tag">{latest.data.material.duration}</span>}
      </p>
      <p class="muted">
        素材：{latest.data.material.source}
        {latest.data.material.videoUrl
          ? <a href={latest.data.material.videoUrl} target="_blank">· 视频直链 ↗</a>
          : ' · 视频直链待提供'}
      </p>
      <a class="btn primary" href={`${BASE}/lessons/${latest.id}/`}>开始学习 →</a>
    </section>
  )}

  <section>
    <h2>按月归档（主题月推进）</h2>
    {[...byMonth.entries()].map(([month, items]) => (
      <div class="card">
        <h3>{month} · <span class="muted">{items[0].data.domain}</span></h3>
        <ul class="lesson-list">
          {items.map((l) => (
            <li>
              <a href={`${BASE}/lessons/${l.id}/`}>{l.data.subScenario}</a>
              <span class="muted"> · {l.data.date}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    {lessons.length === 0 && <p class="muted">还没有课程，先跑一遍流水线生成第一课。</p>}
  </section>

  <section class="card">
    <h3>复习</h3>
    <p class="muted">生词收藏、每日小测错题与 SRS 队列都在复习页，数据存本机。</p>
    <a class="btn" href={BASE + '/review/'}>进入复习 →</a>
  </section>
</BaseLayout>

<style>
  .hero h1 { margin: 6px 0 10px; font-size: 28px; }
  .date-label { margin: 0; }
  .lesson-list { margin: 8px 0 0; padding-left: 20px; }
  .lesson-list li { margin: 4px 0; }
</style>

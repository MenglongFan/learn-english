---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="复习">
  <nav class="crumbs"><a href={BASE + '/'}>← 返回首页</a></nav>

  <section class="card" id="stats"></section>

  <section>
    <h2>SRS 复习队列 <span class="muted hint">— 间隔 1/3/7/14/30 天，答错重置</span></h2>
    <div class="card" id="srs-queue"></div>
  </section>

  <section>
    <h2>生词收藏 <span class="muted hint">— 全部收藏过的表达</span></h2>
    <div class="card" id="collection"></div>
  </section>

  <section class="card">
    <h2>数据备份</h2>
    <p class="muted">学习数据存于本机 localStorage，导出 JSON 可迁移到其他浏览器。</p>
    <button class="btn" id="export-btn">导出 JSON</button>
    <label class="btn" for="import-file">导入 JSON</label>
    <input type="file" id="import-file" accept="application/json" hidden />
  </section>
</BaseLayout>

<script>
  import { store } from '../lib/store';

  const DAY = 86400000;

  function renderStats() {
    const s = store.stats();
    document.getElementById('stats')!.innerHTML =
      `<h2>概览</h2><p><span class="tag">收藏 ${s.collected}</span><span class="tag">队列中 ${s.srs}</span><span class="tag">今日待复习 ${s.due}</span></p>`;
  }

  function renderQueue() {
    const el = document.getElementById('srs-queue')!;
    const items = store.dueItems();
    if (items.length === 0) {
      el.innerHTML = '<p class="muted">今天没有到期的复习项。去课程页收藏新表达吧。</p>';
      return;
    }
    el.innerHTML = '';
    items.forEach(([en, , meaning]) => {
      const card = document.createElement('div');
      card.className = 'srs-item';
      card.innerHTML = `<p class="en srs-en">${en}</p><p class="muted srs-meaning" hidden>${meaning || '（无释义记录）'}</p>`;
      const reveal = document.createElement('button');
      reveal.className = 'btn';
      reveal.textContent = '看释义';
      reveal.addEventListener('click', () => {
        card.querySelector('.srs-meaning')!.removeAttribute('hidden');
        actions.removeAttribute('hidden');
        reveal.setAttribute('hidden', '');
      });
      const actions = document.createElement('div');
      actions.className = 'srs-actions';
      actions.setAttribute('hidden', '');
      const forget = document.createElement('button');
      forget.className = 'btn wrong-btn';
      forget.textContent = '忘了';
      forget.addEventListener('click', () => {
        store.review(en, false);
        card.remove();
        refresh();
      });
      const ok = document.createElement('button');
      ok.className = 'btn primary';
      ok.textContent = '记住了';
      ok.addEventListener('click', () => {
        store.review(en, true);
        card.remove();
        refresh();
      });
      actions.append(forget, ok);
      card.append(reveal, actions);
      el.appendChild(card);
    });
  }

  function renderCollection() {
    const el = document.getElementById('collection')!;
    const items = store.collectedList();
    if (items.length === 0) {
      el.innerHTML = '<p class="muted">还没有收藏。课程页的学习点右上角可以一键收藏。</p>';
      return;
    }
    el.innerHTML = '<ul>' + items.map(([en, c]) =>
      `<li><span class="en">${en}</span><span class="muted"> · ${c.added}</span></li>`,
    ).join('') + '</ul>';
  }

  function refresh() {
    renderStats();
    renderCollection();
  }

  document.getElementById('export-btn')!.addEventListener('click', () => {
    const blob = new Blob([store.exportAll()], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `learn-english-backup-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  document.getElementById('import-file')!.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      const ok = store.importAll(reader.result as string);
      alert(ok ? '导入成功' : '导入失败：JSON 格式不对');
      refresh();
    };
    reader.readAsText(file);
  });

  refresh();
  renderQueue();
</script>

<style>
  .crumbs { margin-bottom: 16px; }
  .hint { font-size: 14px; font-weight: 400; }
  .srs-item { padding: 14px 0; border-bottom: 1px solid var(--border); }
  .srs-item:last-child { border-bottom: none; }
  .srs-en { margin: 0 0 8px; font-size: 18px; font-weight: 600; }
  .srs-actions { display: flex; gap: 10px; margin-top: 10px; }
  .wrong-btn:hover { border-color: var(--danger); color: var(--danger); }
</style>
